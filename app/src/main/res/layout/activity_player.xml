<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/screenBg">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:resize_mode="fit"
        app:surface_type="texture_view"
        app:controller_layout_id="@layout/player_queue_controller"
        app:animation_enabled="false"
        app:use_controller="true" />

    <!-- Outside PlayerControlView: its minimal-mode/layout manager cannot hide or resize these. -->
    <LinearLayout
        android:id="@+id/transportControls"
        android:layout_width="wrap_content"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layoutDirection="ltr"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/playerView"
        app:layout_constraintEnd_toEndOf="@id/playerView"
        app:layout_constraintTop_toTopOf="@id/playerView"
        app:layout_constraintBottom_toBottomOf="@id/playerView">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/queuePrevious"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_transport_circle"
            android:padding="12dp"
            android:src="@drawable/ic_skip_previous"
            android:contentDescription="@string/exo_controls_previous_description"
            app:tint="@color/white" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/queuePlayPause"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_transport_circle"
            android:padding="14dp"
            android:src="@drawable/ic_play_arrow"
            android:contentDescription="@string/exo_controls_play_description"
            app:tint="@color/white" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/queueNext"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_transport_circle"
            android:padding="12dp"
            android:src="@drawable/ic_skip_next"
            android:contentDescription="@string/exo_controls_next_description"
            app:tint="@color/white" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/collapse_video_player"
        android:rotation="90"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintStart_toStartOf="@id/playerView"
        app:layout_constraintTop_toTopOf="@id/playerView"
        app:tint="@color/white" />

    <LinearLayout
        android:id="@+id/modeSwitch"
        android:layout_width="76dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/bg_mode_switch_hit_area"
        android:contentDescription="@string/switch_to_audio"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="@id/playerView"
        app:layout_constraintTop_toTopOf="@id/playerView">

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no">
            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_headset"
                app:tint="@color/nav_inactive" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_mode_switch_active"
            android:importantForAccessibility="no">
            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_play_arrow"
                app:tint="@color/white" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/gestureFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@drawable/bg_icon_scrim"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:visibility="gone"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="@id/playerView"
        app:layout_constraintEnd_toEndOf="@id/playerView"
        app:layout_constraintTop_toTopOf="@id/playerView"
        app:layout_constraintBottom_toBottomOf="@id/playerView" />

    <ImageButton
        android:id="@+id/fullscreenButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_scrim"
        android:contentDescription="@string/action_fullscreen"
        android:src="@drawable/ic_expand"
        app:layout_constraintEnd_toEndOf="@id/playerView"
        app:layout_constraintBottom_toBottomOf="@id/playerView"
        app:tint="@color/white" />

    <ImageButton
        android:id="@+id/scaleButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_scrim"
        android:contentDescription="@string/action_scale_mode"
        android:src="@drawable/ic_tune"
        app:layout_constraintEnd_toStartOf="@id/modeSwitch"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerView">

        <LinearLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Views + date + foldable description (tap to expand / collapse). -->
            <LinearLayout
                android:id="@+id/descCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_soft"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/views"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/descChevron"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:rotation="180"
                        android:src="@drawable/ic_chevron_up"
                        app:tint="@color/on_surface_variant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/descToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/desc_show_more"
                    android:textColor="?attr/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/channelAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImage" />

                <LinearLayout
                    android:id="@+id/channelInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/channelName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/channelSubs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/subscribeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_subscribe_off"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/subscribe"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/actionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/actionFavorite"
                        style="@style/ActionPill">

                        <ImageView
                            android:id="@+id/actionFavoriteIcon"
                            style="@style/ActionPillIcon"
                            android:src="@drawable/ic_favorite_border"
                            app:tint="@color/on_surface" />

                        <TextView
                            android:id="@+id/actionFavoriteLabel"
                            style="@style/ActionPillText"
                            android:text="@string/action_favorite" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionPlaylist"
                        style="@style/ActionPill">

                        <ImageView
                            style="@style/ActionPillIcon"
                            android:src="@drawable/ic_video_library"
                            app:tint="@color/on_surface" />

                        <TextView
                            style="@style/ActionPillText"
                            android:text="@string/action_playlist" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionShare"
                        style="@style/ActionPill">

                        <ImageView
                            style="@style/ActionPillIcon"
                            android:src="@drawable/ic_share"
                            app:tint="@color/on_surface" />

                        <TextView
                            style="@style/ActionPillText"
                            android:text="@string/action_share" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionDownload"
                        style="@style/ActionPill">

                        <ImageView
                            android:id="@+id/actionDownloadIcon"
                            style="@style/ActionPillIcon"
                            android:src="@drawable/ic_download"
                            app:tint="@color/on_surface" />

                        <TextView
                            android:id="@+id/actionDownloadLabel"
                            style="@style/ActionPillText"
                            android:text="@string/action_download" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionTimer"
                        style="@style/ActionPill">

                        <ImageView
                            style="@style/ActionPillIcon"
                            android:src="@drawable/ic_sleep_timer"
                            app:tint="@color/on_surface" />

                        <TextView
                            style="@style/ActionPillText"
                            android:id="@+id/actionTimerLabel"
                            android:text="@string/sleep_timer_button" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionPip"
                        style="@style/ActionPill">

                        <ImageView
                            style="@style/ActionPillIcon"
                            android:src="@drawable/ic_pip"
                            app:tint="@color/on_surface" />

                        <TextView
                            style="@style/ActionPillText"
                            android:text="@string/action_pip" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Comments entry: count + top comment preview, opens the sheet. -->
            <LinearLayout
                android:id="@+id/commentsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_soft"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chat_bubble"
                        app:tint="@color/on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/comments_title"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/commentsCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/on_surface_variant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/commentsPreviewRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/commentsPreviewAvatar"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircleImage" />

                    <TextView
                        android:id="@+id/commentsPreviewText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/commentsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/comments_loading"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:alpha="0.5"
                android:background="@color/outline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="2dp"
                android:text="@string/related_videos"
                android:textColor="@color/on_surface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/relatedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/on_surface_variant" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/retry" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
